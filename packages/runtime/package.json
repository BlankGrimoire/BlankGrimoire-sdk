{
  "name": "@blankgrimoire/runtime",
  "version": "1.2.0",
  "description": "Declarative extraction runtime for BlankGrimoire theme adapters.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime.js": "./dist/runtime.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlankGrimoire/BlankGrimoire-sdk",
    "directory": "packages/runtime"
  },
  "dependencies": {
    "@blankgrimoire/types": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @blankgrimoire/types... build && pnpm build",
    "test": "vitest run --passWithNoTests"
  }
}
