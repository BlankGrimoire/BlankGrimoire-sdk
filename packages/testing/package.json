{
  "name": "@blankgrimoire/testing",
  "version": "1.0.0",
  "description": "Node testing harness and mock server for BlankGrimoire theme adapters.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlankGrimoire/BlankGrimoire-sdk",
    "directory": "packages/testing"
  },
  "dependencies": {
    "@blankgrimoire/runtime": "workspace:*",
    "@blankgrimoire/types": "workspace:*",
    "jsdom": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @blankgrimoire/runtime... build",
    "test": "vitest run --passWithNoTests"
  }
}
