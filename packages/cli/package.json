{
  "name": "@blankgrimoire/cli",
  "version": "1.0.0",
  "description": "Build, manifest and signing tooling for BlankGrimoire theme adapters.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "blankgrimoire": "dist/cli.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlankGrimoire/BlankGrimoire-sdk",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@blankgrimoire/types": "workspace:*",
    "esbuild": "^0.24.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @blankgrimoire/types... build && pnpm build",
    "test": "vitest run --passWithNoTests"
  }
}
