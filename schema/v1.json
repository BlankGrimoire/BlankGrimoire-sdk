{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AdapterManifest": {
      "additionalProperties": false,
      "description": "No baseURL and no domains: hosts come from the user's SiteProfile.",
      "properties": {
        "apiVersion": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "signature": {
          "$ref": "#/definitions/ThemeSignature"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "apiVersion",
        "signature",
        "sha256"
      ],
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "credits": {
          "type": "string"
        },
        "logoURL": {
          "$ref": "#/definitions/URLString"
        },
        "siteName": {
          "type": "string"
        },
        "siteURL": {
          "$ref": "#/definitions/URLString"
        }
      },
      "required": [
        "siteName",
        "siteURL"
      ],
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "language": {
          "description": "BCP-47 language tag.",
          "type": "string"
        },
        "number": {
          "type": "number"
        },
        "publishedAt": {
          "$ref": "#/definitions/ISODateString"
        },
        "title": {
          "type": "string"
        },
        "volume": {
          "type": "number"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "ContentRating": {
      "enum": [
        "safe",
        "suggestive",
        "mature"
      ],
      "type": "string"
    },
    "ExtractionStrategy": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            },
            "kind": {
              "const": "css",
              "type": "string"
            },
            "srcAttributes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "image",
            "srcAttributes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base64": {
              "type": "boolean"
            },
            "kind": {
              "const": "scriptJSON",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "pattern",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "framework": {
              "enum": [
                "next",
                "nuxt"
              ],
              "type": "string"
            },
            "kind": {
              "const": "hydration",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "framework"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "type": "string"
            },
            "kind": {
              "const": "ajax",
              "type": "string"
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ],
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "then": {
              "$ref": "#/definitions/ExtractionStrategy"
            }
          },
          "required": [
            "kind",
            "method",
            "path",
            "then"
          ],
          "type": "object"
        }
      ]
    },
    "HttpRequest": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "HttpResponse": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "status": {
          "type": "number"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "url",
        "headers",
        "body"
      ],
      "type": "object"
    },
    "ISODateString": {
      "description": "ISO 8601 date-time string. Decoded with `.iso8601` in Swift.",
      "type": "string"
    },
    "MangaDetails": {
      "additionalProperties": false,
      "properties": {
        "altTitles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "artists": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attribution": {
          "$ref": "#/definitions/Attribution"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contentRating": {
          "$ref": "#/definitions/ContentRating"
        },
        "coverURL": {
          "$ref": "#/definitions/URLString"
        },
        "key": {
          "description": "Opaque, stable key chosen by the adapter.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/MangaStatus"
        },
        "synopsis": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "contentRating",
        "key",
        "status",
        "title"
      ],
      "type": "object"
    },
    "MangaStatus": {
      "description": "Publication status. Swift maps unknown values to `unknown`.",
      "enum": [
        "ongoing",
        "completed",
        "hiatus",
        "cancelled",
        "unknown"
      ],
      "type": "string"
    },
    "MangaSummary": {
      "additionalProperties": false,
      "properties": {
        "coverURL": {
          "$ref": "#/definitions/URLString"
        },
        "key": {
          "description": "Opaque, stable key chosen by the adapter.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "type": "object"
    },
    "MangaSummaryPage": {
      "$ref": "#/definitions/PagedResult%3CMangaSummary%3E",
      "description": "Concrete alias so the JSON Schema gets a named definition for fixtures."
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "imageURL": {
          "$ref": "#/definitions/URLString"
        },
        "index": {
          "type": "number"
        }
      },
      "required": [
        "index",
        "imageURL"
      ],
      "type": "object"
    },
    "PagedResult<MangaSummary>": {
      "additionalProperties": false,
      "properties": {
        "hasNextPage": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/definitions/MangaSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "hasNextPage"
      ],
      "type": "object"
    },
    "PagesConfig": {
      "additionalProperties": false,
      "properties": {
        "strategies": {
          "description": "Tried in order; the first non-empty result wins.",
          "items": {
            "$ref": "#/definitions/ExtractionStrategy"
          },
          "type": "array"
        }
      },
      "required": [
        "strategies"
      ],
      "type": "object"
    },
    "RepositoryIndex": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "apiVersion": {
                "type": "number"
              },
              "bundleURL": {
                "description": "Relative to the repository index.",
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "apiVersion",
              "bundleURL",
              "sha256",
              "signature"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "formatVersion": {
          "const": 1,
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "publicKey": {
          "description": "Format: \"ed25519:BASE64\".",
          "type": "string"
        }
      },
      "required": [
        "formatVersion",
        "name",
        "publicKey",
        "extensions"
      ],
      "type": "object"
    },
    "SearchQuery": {
      "additionalProperties": false,
      "properties": {
        "filters": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "page": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "page"
      ],
      "type": "object"
    },
    "SiteContext": {
      "additionalProperties": false,
      "description": "The site is always chosen by the user, never by the adapter.",
      "properties": {
        "baseURL": {
          "type": "string"
        },
        "overrides": {
          "additionalProperties": false,
          "properties": {
            "attribution": {
              "additionalProperties": false,
              "properties": {
                "credits": {
                  "type": "string"
                },
                "logo": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "chapters": {
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "item": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                },
                "order": {
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "item",
                "link",
                "order"
              ],
              "type": "object"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "authors": {
                  "type": "string"
                },
                "cover": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "synopsis": {
                  "type": "string"
                },
                "tags": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "type": "object"
            },
            "pages": {
              "$ref": "#/definitions/PagesConfig"
            },
            "search": {
              "additionalProperties": false,
              "properties": {
                "cover": {
                  "type": "string"
                },
                "item": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                },
                "nextPage": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "item",
                "title",
                "link"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "siteName": {
          "type": "string"
        }
      },
      "required": [
        "baseURL",
        "siteName",
        "overrides"
      ],
      "type": "object"
    },
    "ThemeAdapter": {
      "additionalProperties": false,
      "properties": {
        "hooks": {
          "$ref": "#/definitions/ThemeHooks"
        },
        "id": {
          "description": "For example: \"theme.example\".",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "selectors": {
          "$ref": "#/definitions/ThemeSelectors"
        },
        "signature": {
          "$ref": "#/definitions/ThemeSignature"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "signature",
        "selectors"
      ],
      "type": "object"
    },
    "ThemeHooks": {
      "additionalProperties": false,
      "type": "object"
    },
    "ThemeSelectors": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "additionalProperties": false,
          "properties": {
            "credits": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "chapters": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string"
            },
            "item": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "order": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "item",
            "link",
            "order"
          ],
          "type": "object"
        },
        "details": {
          "additionalProperties": false,
          "properties": {
            "authors": {
              "type": "string"
            },
            "cover": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "synopsis": {
              "type": "string"
            },
            "tags": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title"
          ],
          "type": "object"
        },
        "pages": {
          "$ref": "#/definitions/PagesConfig"
        },
        "search": {
          "additionalProperties": false,
          "properties": {
            "cover": {
              "type": "string"
            },
            "item": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "nextPage": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "item",
            "title",
            "link"
          ],
          "type": "object"
        }
      },
      "required": [
        "search",
        "details",
        "chapters",
        "pages"
      ],
      "type": "object"
    },
    "ThemeSignature": {
      "additionalProperties": false,
      "description": "Theme detection signature. Scoring is done in Swift:\n- metaGenerator match: +3\n- each matching selector: +2\n- each matching scriptSrc regex: +1\n- each probePath returning 2xx: +3",
      "properties": {
        "metaGenerator": {
          "description": "Regex matched against `<meta name=\"generator\">`.",
          "type": "string"
        },
        "minScore": {
          "type": "number"
        },
        "probePaths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scriptSrc": {
          "description": "Regexes matched against script `src` attributes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "selectors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "minScore"
      ],
      "type": "object"
    },
    "URLString": {
      "description": "Absolute URL, or URL relative to the site `baseURL`.",
      "type": "string"
    },
    "defineTheme": {
      "$comment": "(adapter: ThemeAdapter) => ThemeAdapter & { apiVersion: 1 }",
      "properties": {
        "namedArgs": {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "$ref": "#/definitions/ThemeAdapter"
            }
          },
          "required": [
            "adapter"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  }
}