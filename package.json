{
  "name": "blankgrimoire-sdk",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schema": "ts-json-schema-generator -p packages/types/src/index.ts -t '*' -o schema/v1.json --no-type-check",
    "schema:check": "pnpm schema && git diff --exit-code -- schema/v1.json"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
