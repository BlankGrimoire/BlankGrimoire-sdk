{
  "name": "blankgrimoire-sdk",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schema": "pnpm --filter @blankgrimoire/types typecheck && ts-json-schema-generator -p packages/types/src/schema.ts -t \"*\" -o schema/v1.json",
    "schema:check": "pnpm schema && git diff --exit-code -- schema/v1.json",
    "release:assets": "bash scripts/release-assets.sh",
    "publish:check": "pnpm build && PUBLISH_DRY_RUN=1 bash scripts/publish-packages.sh"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "semantic-release": "25.0.9",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
