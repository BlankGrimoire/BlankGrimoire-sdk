{
  "id": "theme.example",
  "name": "Example Theme",
  "version": "1.0.0",
  "detectionSignature": {
    "selectors": [".example-reader"],
    "minScore": 2
  },
  "selectors": {
    "search": {
      "path": "/search",
      "item": ".result",
      "title": ".result-title",
      "link": "a"
    },
    "details": {
      "title": "h1.series-title"
    },
    "chapters": {
      "item": ".chapter",
      "link": "a",
      "order": "desc"
    },
    "pages": {
      "strategies": [
        {
          "kind": "css",
          "image": ".reader img",
          "srcAttributes": ["src"]
        }
      ]
    }
  }
}
